# Local: un archivo. Producción: libsql://<tu-base>.turso.io
DATABASE_URL=file:./data/dev.db
DATABASE_AUTH_TOKEN=
SESSION_SECRET=
# Resend (https://resend.com). Vacías = modo simulación: no se envía nada.
RESEND_API_KEY=
MAIL_FROM=
# URL pública para los links de voto y callbacks OAuth (opcional; en Vercel se usa el dominio del despliegue)
APP_URL=
# Google OAuth 2.0 (SSO). Vacías = botón de Google deshabilitado.
# URI de redirección autorizada: <APP_URL o dominio>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
