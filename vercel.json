{
  "functions": {
    "api/[...route].ts": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/login", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/(.*)", "destination": "/index.html" },
    { "source": "/vote", "destination": "/index.html" },
    { "source": "/vote/(.*)", "destination": "/index.html" },
    { "source": "/questionnaire", "destination": "/index.html" },
    { "source": "/questionnaire/(.*)", "destination": "/index.html" }
  ]
}
